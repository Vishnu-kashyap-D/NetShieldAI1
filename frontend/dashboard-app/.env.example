# Copy to .env.local to override. Neither variable is required -- both have
# sensible defaults (see src/data/config.ts).

# "mock" (default) uses locally-generated demo data; "real" talks to the FastAPI backend.
VITE_DATA_MODE=mock

# Only used when VITE_DATA_MODE=real.
VITE_API_BASE_URL=http://localhost:8000
