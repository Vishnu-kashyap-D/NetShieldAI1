DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=netshield

# Explainability chatbot (backend/app/chat_service.py). Optional -- deterministic questions
# (confidence, anomaly score, top SHAP features, glossary lookups, ...) work without it.
# Open-ended questions return an honest "unavailable" message when this is unset. Never commit
# a real key here -- this file is the template; put your actual key in backend/.env (gitignored).
ANTHROPIC_API_KEY=
CHAT_LLM_MODEL=claude-opus-5
