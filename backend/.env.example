DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=netshield

# Both chatbots (the per-alert assistant's LLM fallback, and the sidebar's general "SHAP"
# project/threat assistant) run on this one key. Deterministic per-alert questions (confidence,
# anomaly score, top SHAP features, glossary lookups, ...) work without it either way. Open-ended
# questions on either assistant return an honest "unavailable" message when this is unset. Never
# commit a real key here -- this file is the template; put your actual key in backend/.env (gitignored).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Security settings (all optional; the values shown are the defaults) -------------------------
# MUST be true once the API is served over HTTPS. Left false on purpose for local development: a
# `Secure` cookie is silently dropped by browsers on plain http://localhost, so login would appear
# to do nothing.
# SESSION_COOKIE_SECURE=false
#
# Failed-login lockout: this many failures per (client IP, email), and per client IP overall,
# within the window below, then 429 until the oldest failure ages out.
# LOGIN_MAX_FAILURES=5
# LOGIN_IP_MAX_FAILURES=20
# LOGIN_WINDOW_SECONDS=300
#
# Chat requests per minute per signed-in user, shared by both chatbots (each may call the paid LLM).
# CHAT_MAX_REQUESTS_PER_MINUTE=20

# --- Browser access (CORS + CSRF origin check) ---------------------------------------------------
# Origins allowed to call this API from a browser. The same list drives BOTH CORS and the Origin
# check on state-changing requests (app/security.py), so the dashboard's address must be here.
# MUST be a JSON list -- a comma-separated string (a.com,b.com) fails to parse and the app won't
# start. The defaults are the Create-React-App and Vite dev-server ports.
# CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- Uploads and sessions -------------------------------------------------------------------------
# Largest CSV POST /api/ingest/csv accepts, in bytes (default 200 MB); bigger uploads get a 413.
# MAX_UPLOAD_BYTES=209715200
# Name of the session cookie, and how long a sign-in lasts (default 7 days = 168 hours).
# SESSION_COOKIE_NAME=netshield_session
# SESSION_TTL_HOURS=168

# --- File locations (all default to paths inside this repo; relative paths resolve against the
# --- directory the server is started from, so absolute paths are safer if you override any) --------
# Trained models + preprocessing.joblib the API loads at startup and after an accepted retrain.
# ARTIFACTS_DIR=<repo>/artifacts
# Where training_metrics.json is read from (retrain quality gate, /api/stats/model-metrics).
# REPORTS_DIR=<repo>/reports
# Per-run retraining logs.
# TRAINING_LOGS_DIR=<repo>/reports/training_runs
# CICIDS2017 CSVs used by cyber_ai.train during a retrain.
# DATA_DIR=<repo>/MachineLearningCVE
# Curated CSV that POST /api/ingest/demo scores.
# DEMO_CSV=<repo>/demo/panel_demo_traffic.csv
# Analyst-validated training rows (POST /api/feedback appends here; retrains read it).
# FEEDBACK_STORE=<repo>/data/feedback/validated_traffic.csv
# Training config used by a retrain.
# TRAIN_CONFIG=<repo>/configs/default.yaml
# Marker file every worker watches to know when to reload the model after a retrain (see
# "Running with multiple workers" in README.md). Keep it outside ARTIFACTS_DIR, and on a path all
# workers can read; if you run several workers, don't change it per worker.
# MODEL_GENERATION_FILE=<repo>/.model_generation

# --- Model behaviour (Phase 6) ---------------------------------------------------------------------
# "Unknown" instead of a forced category. The classifier is trained on attacks only, so it can never say "none of
# these": a false alarm on ordinary traffic still gets one of the six attack names. Set this to a confidence
# between 0 and 1 and any flagged window the classifier is LESS sure of than that is labelled "Unknown" instead.
# 0.9 is what the validation windows recommend (python -m cyber_ai.abstention_analysis): ~97% of real attacks keep
# their name (and are ~99.97% right), ~88% of false alarms become "Unknown". Only labels change -- scores, risk
# levels and alert counts do not. Unset (or 0) = off, which is the default. Leave the line commented out to disable;
# do not leave the value empty.
# UNKNOWN_CONFIDENCE_THRESHOLD=0.9

# Cross-window "campaigns": long runs of consecutive windows the classifier keeps reading as the SAME category at
# very high confidence, whether or not the Autoencoder flagged them (it misses most Port Scanning, for example).
# Additive -- no alert or label changes -- but it makes the classifier score every window (~0.5 ms/window: ingest
# takes roughly 1.4-1.5x as long).
# The defaults come from python -m cyber_ai.correlation_eval; loosen them only after re-running it.
# CAMPAIGN_DETECTION_ENABLED=true
# CAMPAIGN_MIN_CONFIDENCE=0.99     # 0.5-1.0: how sure the classifier must be, window after window
# CAMPAIGN_MIN_WINDOWS=8           # >= 3: how many consecutive windows make a campaign
# CAMPAIGN_MAX_GAP=1               # 0-5: off-pattern windows tolerated in a row inside one run
