{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "netshield-backend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--reload", "--port", "8000", "--app-dir", "backend"],
      "port": 8000
    },
    {
      "name": "netshield-frontend",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "5500", "--directory", "frontend"],
      "port": 5500
    },
    {
      "name": "netshield-dashboard-app",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend/dashboard-app", "run", "dev", "--", "--port", "5173", "--strictPort"],
      "port": 5173
    }
  ]
}
